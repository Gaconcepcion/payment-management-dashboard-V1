VAR _lang = SELECTEDVALUE ( LanguageSelector[LanguageCode], "ES" )
VAR _t1 = SWITCH ( _lang, "EN", "Technology Orders", "PT", "Pedidos Tecnologia", "Pedidos Tecnología" )
VAR _t2 = SWITCH ( _lang, "EN", "Pending Execution", "PT", "Pendentes de Execução", "Pendientes de Ejecución" )
VAR _sub = SWITCH ( _lang, "EN", "Welcome to the order tracking dashboard. Here you will find the key information for more effective vendor and budget management.", "PT", "Bem-vindo ao painel de acompanhamento de pedidos. Aqui você encontra as informações-chave para uma gestão mais eficaz de fornecedores e orçamentos.", "Bienvenido al panel de seguimiento de pedidos. Aquí encontrarás la información clave para una gestión de proveedores y presupuestos más efectiva." )
VAR _hint = SWITCH ( _lang, "EN", "Move your mouse to interact", "PT", "Mova o mouse para interagir", "Mueve el mouse para interactuar" )
VAR _tab1 = SWITCH ( _lang, "EN", "Pending Orders", "PT", "Pedidos Pendentes", "Pedidos Pendientes" )
VAR _tab2 = SWITCH ( _lang, "EN", "% Executed by order", "PT", "% Executado por pedido", "% Ejecutado por pedido" )
VAR _tab3 = SWITCH ( _lang, "EN", "Overdue Delivery", "PT", "Entrega Atrasada", "Entrega Vencida" )
VAR _config = SWITCH ( _lang, "EN", "Settings", "PT", "Configurações", "Configuración" )
VAR _badge = SWITCH ( _lang, "EN", "Vendor Management", "PT", "Gestão de Fornecedores", "Gestión de Proveedores" )
VAR _cta = SWITCH ( _lang, "EN", "Leave us your feedback", "PT", "Deixe seu feedback", "Déjanos tu feedback" )
RETURN
    "<div class='demo-cover'>
  <div class='deco'>
    <svg viewBox='0 0 1280 720' preserveAspectRatio='xMidYMid slice'>
      <circle cx='860' cy='30' r='300' class='ring ring-a'></circle>
      <circle cx='900' cy='120' r='210' class='ring ring-b'></circle>
      <circle cx='790' cy='10' r='380' class='ring ring-c'></circle>
    </svg>
    <span class='dot d1'></span>
    <span class='dot d2'></span>
    <span class='dot d3'></span>
    <span class='dot d4'></span>
    <span class='dot d5'></span>
  </div>
  <div class='topbar'>
    <span class='badge'>" &
    _badge &
    "</span>
    <nav class='navlinks'>
      <span class='navitem' data-idx='0'>" &
    _tab1 &
    "</span>
      <span class='navitem' data-idx='1'>" &
    _tab2 &
    "</span>
      <span class='navitem' data-idx='2'>" &
    _tab3 &
    "</span>
    </nav>
  </div>
  <div class='hero'>
    <h1 class='t1'>" &
    _t1 &
    "</h1>
    <h2 class='t2'>" &
    _t2 &
    "</h2>
    <p class='sub'>" &
    _sub &
    "</p>
  </div>
  <span class='hint'>" &
    _hint &
    "</span>
  <button class='arrow-btn' title='" &
    _config &
    "' type='button'>&#8250;</button>
  <button class='cta-btn' type='button'>" &
    _cta &
    "</button>
</div>
<style>
.demo-cover *{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;}
.demo-cover{position:relative;width:100vw;height:100vh;min-height:560px;overflow:hidden;border-radius:0;background:linear-gradient(135deg,#ffffff 0%,#fff6f8 55%,#ffe3ec 100%);font-family:'Segoe UI',Tahoma,Arial,sans-serif;}
.demo-cover .deco{position:absolute;inset:0;pointer-events:none;transition:transform .25s ease-out;}
.demo-cover .deco svg{position:absolute;top:0;left:0;width:100%;height:100%;}
.demo-cover .ring{fill:none;stroke:rgba(224,58,105,.16);stroke-width:1.4;transform-origin:center;}
.demo-cover .ring-a{animation:demoDriftA 10s ease-in-out infinite;}
.demo-cover .ring-b{stroke:rgba(224,58,105,.24);animation:demoDriftB 8s ease-in-out infinite;}
.demo-cover .ring-c{stroke:rgba(224,58,105,.09);animation:demoDriftA 13s ease-in-out infinite;}
.demo-cover .dot{position:absolute;bottom:-16px;border-radius:50%;background:#f0a0bc;animation:demoFloatUp linear infinite;}
.demo-cover .d1{left:12%;width:7px;height:7px;animation-duration:8s;}
.demo-cover .d2{left:30%;width:5px;height:5px;animation-duration:10.5s;animation-delay:1.4s;}
.demo-cover .d3{left:52%;width:9px;height:9px;animation-duration:9s;animation-delay:3s;}
.demo-cover .d4{left:74%;width:6px;height:6px;animation-duration:11s;animation-delay:.6s;}
.demo-cover .d5{left:90%;width:8px;height:8px;animation-duration:7.5s;animation-delay:2.2s;}
.demo-cover .topbar{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;padding:40px 5% 0;}
.demo-cover .badge{background:linear-gradient(135deg,#ff5f8f,#e23a6b);color:#fff;font-weight:700;font-size:clamp(10px,1.1vw,13px);letter-spacing:.4px;padding:.6em 1.4em;border-radius:30px;box-shadow:0 10px 22px rgba(226,58,107,.35);animation:demoFadeDown .8s ease both;white-space:nowrap;}
.demo-cover .navlinks{display:flex;gap:clamp(6px,1vw,14px);}
.demo-cover .navitem{display:block;font-weight:800;font-size:clamp(9px,1vw,12px);letter-spacing:.5px;color:#e23a6b;text-transform:uppercase;text-align:center;max-width:120px;line-height:1.35;animation:demoFadeDown .8s ease both;cursor:pointer;padding:10px 14px;border-radius:20px;transition:background .25s ease,color .25s ease,transform .12s ease;user-select:none;}
.demo-cover .navitem:nth-child(2){animation-delay:.08s;}
.demo-cover .navitem:nth-child(3){animation-delay:.16s;}
.demo-cover .navitem:hover{background:rgba(226,58,107,.1);}
.demo-cover .navitem:active{transform:scale(.93);}
.demo-cover .navitem.active{background:linear-gradient(135deg,#ff5f8f,#e23a6b);color:#fff;box-shadow:0 8px 18px rgba(226,58,107,.35);}
.demo-cover .hero{position:relative;z-index:2;padding:5% 8% 0 8%;max-width:640px;}
.demo-cover .t1{margin:0;font-size:clamp(26px,5vw,54px);font-weight:800;color:#3d3942;line-height:1.05;animation:demoFadeUp .9s ease both;}
.demo-cover .t2{margin:.15em 0 0;font-size:clamp(20px,3.8vw,42px);font-weight:300;color:#47434c;line-height:1.1;animation:demoFadeUp .9s .12s ease both;}
.demo-cover .sub{margin-top:1.1em;font-size:clamp(12px,1.35vw,16px);line-height:1.6;color:#726d78;max-width:34em;animation:demoFadeUp .9s .24s ease both;}
.demo-cover .hint{position:absolute;left:8%;bottom:132px;z-index:2;font-size:clamp(9px,1vw,12px);color:#b3a8b0;letter-spacing:.3px;animation:demoPulse 3s ease-in-out infinite;}
.demo-cover .arrow-btn{position:absolute;left:8%;bottom:48px;z-index:2;width:clamp(38px,4.5vw,56px);height:clamp(38px,4.5vw,56px);border:none;border-radius:50%;background:linear-gradient(135deg,#ff5f8f,#e23a6b);color:#fff;font-size:clamp(16px,2vw,22px);cursor:pointer;box-shadow:0 12px 26px rgba(226,58,107,.4);animation:demoNudge 2.4s ease-in-out infinite;}
.demo-cover .cta-btn{position:absolute;right:6%;bottom:48px;z-index:2;background:#fff;border:2px solid #e23a6b;color:#e23a6b;font-weight:700;font-size:clamp(10px,1.15vw,14px);padding:.9em 1.6em;border-radius:18px;cursor:pointer;box-shadow:0 10px 24px rgba(226,58,107,.15);transition:transform .25s ease,background .25s ease,color .25s ease;animation:demoFadeUp .9s .36s ease both;}
.demo-cover .cta-btn:hover{background:#e23a6b;color:#fff;transform:translateY(-3px);}
@keyframes demoFadeDown{from{opacity:0;transform:translateY(-14px);}to{opacity:1;transform:translateY(0);}}
@keyframes demoFadeUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
@keyframes demoPulse{0%,100%{opacity:.45;}50%{opacity:.9;}}
@keyframes demoNudge{0%,100%{transform:translateX(0);}50%{transform:translateX(6px);}}
@keyframes demoDriftA{0%,100%{transform:translate(0,0) rotate(0deg);}50%{transform:translate(10px,-8px) rotate(3deg);}}
@keyframes demoDriftB{0%,100%{transform:translate(0,0) rotate(0deg);}50%{transform:translate(-8px,10px) rotate(-4deg);}}
@keyframes demoFloatUp{0%{transform:translateY(0);opacity:0;}12%{opacity:.55;}88%{opacity:.25;}100%{transform:translateY(-160px);opacity:0;}}
</style>
<script>
(function(){
  var root = document.currentScript.parentNode;
  var deco = root.querySelector('.deco');
  if(!root || !deco){return;}
  root.addEventListener('mousemove', function(e){
    var r = root.getBoundingClientRect();
    var x = (e.clientX - r.left) / r.width - 0.5;
    var y = (e.clientY - r.top) / r.height - 0.5;
    deco.style.transform = 'translate(' + (x*16).toFixed(1) + 'px,' + (y*12).toFixed(1) + 'px)';
  });
  root.addEventListener('mouseleave', function(){
    deco.style.transform = 'translate(0,0)';
  });
  var navs = root.querySelectorAll('.navitem');
  for(var i=0;i<navs.length;i++){
    navs[i].addEventListener('click', function(ev){
      for(var j=0;j<navs.length;j++){ navs[j].classList.remove('active'); }
      ev.currentTarget.classList.add('active');
    });
  }
})();
</script>
"